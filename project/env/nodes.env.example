# Master link parameters
MASTER_HOST=example.com
MASTER_VLESS_PORT=443
MASTER_SUB_PORT=8443
MASTER_SNI=www.google.com
MASTER_PBK=__SET_ME__
MASTER_SID=ffffffffff
MASTER_FP=firefox
MASTER_SPX=/

# Alternative master profile: VLESS WebSocket behind nginx TLS.
MASTER_WS_ENABLED=1
MASTER_WS_PORT=2053
MASTER_WS_SNI=example.com
MASTER_WS_PATH=/api/v1/stream
MASTER_WS_FP=chrome

# Replica UK node (optional)
UK_HOST=
UK_VLESS_PORT=443
UK_SNI=www.yahoo.com
UK_PBK=
UK_SID=ffffffffff
UK_FP=firefox
UK_SPX=/

# Replica TR node (optional)
TR_HOST=
TR_LINK_HOST=
TR_VLESS_PORT=443
TR_SNI=www.yahoo.com
TR_PBK=
TR_LINK_PBK=
TR_SID=ffffffffff
TR_FP=firefox
TR_SPX=/

# Alternative TR profile: VLESS WebSocket behind nginx TLS.
TR_WS_ENABLED=0
TR_WS_HOST=tr.example.com
TR_WS_PORT=2053
TR_WS_SNI=tr.example.com
TR_WS_PATH=/api/v1/stream
TR_WS_FP=chrome

# SSH key for sync to replicas
SSH_KEY=/root/.ssh/vless_sync_ed25519
