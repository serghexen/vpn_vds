{
  "listen": ":2443",
  "tls": {
    "cert": "/etc/letsencrypt/live/__DOMAIN__/fullchain.pem",
    "key": "/etc/letsencrypt/live/__DOMAIN__/privkey.pem",
    "sniGuard": "strict"
  },
  "auth": {"type": "password", "password": "__AUTH_PASSWORD__"},
  "obfs": {"type": "salamander", "salamander": {"password": "__OBFS_PASSWORD__"}},
  "ignoreClientBandwidth": true,
  "quic": {"maxIncomingStreams": 128},
  "acl": {
    "inline": [
      "reject(0.0.0.0/8)",
      "reject(10.0.0.0/8)",
      "reject(127.0.0.0/8)",
      "reject(169.254.0.0/16)",
      "reject(172.16.0.0/12)",
      "reject(192.168.0.0/16)",
      "reject(::1/128)",
      "reject(fc00::/7)",
      "reject(fe80::/10)"
    ]
  }
}
