# Include inside the existing replica HTTPS server block.
# Render all __MASTER_*__ placeholders before installation.
location ~ "^/(sub/[A-Za-z0-9._-]+|support)$" {
    limit_except GET { deny all; }

    proxy_pass https://__MASTER_IP__:__MASTER_SUB_PORT__;
    proxy_http_version 1.1;
    proxy_set_header Host __MASTER_DOMAIN__:__MASTER_SUB_PORT__;
    proxy_set_header Connection "";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;

    proxy_ssl_server_name on;
    proxy_ssl_name __MASTER_DOMAIN__;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 3;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

    proxy_connect_timeout 5s;
    proxy_read_timeout 20s;
    proxy_send_timeout 20s;
    proxy_buffering off;
    proxy_cache off;

    # Subscription URLs may contain credentials; the master keeps its own log.
    access_log off;
}
